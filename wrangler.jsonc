{
  "name": "cesta-compra",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "cesta-compra", "database_id": "f1542297-38bc-433e-a7fd-1885d4b1a8a9", "migrations_dir": "migrations" }
  ],
  // The web app, built by `npm run build` into dist/client. The Worker runs first only for
  // the API and /health; any other path is a file of the app, or index.html (hash routing).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  // Once a day, early morning UTC: the demo seed and the Open Prices import.
  "triggers": { "crons": ["17 5 * * *"] }
  // Secret, not configured here: LIVE_KEY (npx wrangler secret put LIVE_KEY; locally .dev.vars).
}
